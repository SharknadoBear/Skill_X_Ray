{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/skill-xray/0.1/skill-xray.schema.json",
  "title": "Skill X-Ray graph 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "nodes", "edges", "casting_notes"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "source_path", "generated_at", "caster_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "source_path": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "caster_version": {"const": "0.1"}
      }
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "casting_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_items", "inferred_items", "ambiguities", "omissions"],
      "properties": {
        "explicit_items": {"$ref": "#/$defs/string_array"},
        "inferred_items": {"$ref": "#/$defs/string_array"},
        "ambiguities": {"$ref": "#/$defs/string_array"},
        "omissions": {"$ref": "#/$defs/string_array"}
      }
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "heading": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "required"],
      "properties": {
        "id": {"type": "string", "pattern": "^G[1-9][0-9]*-C[1-9][0-9]*$"},
        "text": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "summary", "source_refs", "extraction_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[WTEGS][1-9][0-9]*$"},
        "type": {"enum": ["working_state", "tool", "example", "gate_collection", "skill_call"]},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "details": {"type": "string"},
        "inputs": {"$ref": "#/$defs/string_array"},
        "outputs": {"$ref": "#/$defs/string_array"},
        "constraints": {"$ref": "#/$defs/string_array"},
        "terminal": {"type": "boolean"},
        "tool_name": {"type": "string"},
        "tool_category": {"type": "string"},
        "script_path": {"type": "string"},
        "call_pattern": {"type": "string"},
        "preconditions": {"$ref": "#/$defs/string_array"},
        "example_text": {"type": "string"},
        "demonstrates": {"type": "string"},
        "target_tool_id": {"type": "string", "pattern": "^T[1-9][0-9]*$"},
        "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
        "required_evidence": {"$ref": "#/$defs/string_array"},
        "target_skill": {"type": "string"},
        "target_skill_path": {"type": "string"},
        "target_xray_href": {"type": "string"},
        "passed_inputs": {"$ref": "#/$defs/string_array"},
        "expected_outputs": {"$ref": "#/$defs/string_array"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
        "extraction_status": {"enum": ["explicit", "inferred", "ambiguous"]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "working_state"}}},
          "then": {
            "required": ["details", "inputs", "outputs", "constraints", "terminal"],
            "properties": {"id": {"pattern": "^W[1-9][0-9]*$"}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "tool"}}},
          "then": {
            "required": ["tool_name", "tool_category", "inputs", "outputs", "preconditions"],
            "properties": {"id": {"pattern": "^T[1-9][0-9]*$"}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "example"}}},
          "then": {
            "required": ["example_text", "demonstrates", "target_tool_id"],
            "properties": {"id": {"pattern": "^E[1-9][0-9]*$"}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "gate_collection"}}},
          "then": {
            "required": ["criteria", "required_evidence"],
            "properties": {"id": {"pattern": "^G[1-9][0-9]*$"}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "skill_call"}}},
          "then": {
            "required": ["target_skill", "target_skill_path", "passed_inputs", "expected_outputs"],
            "properties": {"id": {"pattern": "^S[1-9][0-9]*$"}}
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "type", "condition", "summary", "source_refs", "extraction_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^X[1-9][0-9]*$"},
        "source": {"type": "string", "pattern": "^[WTEGS][1-9][0-9]*$"},
        "target": {"type": "string", "pattern": "^[WTEGS][1-9][0-9]*$"},
        "type": {"enum": ["flow", "gate_advance", "gate_iterate", "gate_finish", "tool_support", "example_guidance", "skill_invoke", "skill_return"]},
        "condition": {"type": "string"},
        "summary": {"type": "string"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
        "extraction_status": {"enum": ["explicit", "inferred", "ambiguous"]}
      }
    }
  }
}
